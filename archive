<!DOCTYPE html>
<html lang="en-CA">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>⭐</text></svg>">

    <title>The Vault | 400+ Unfiltered Toronto & Global Reviews by MsJAG</title>
    <meta name="description" content="Search the complete archive of level 7 Google Guide MsJAG. Honest, unsponsored verdicts on Toronto clubs, dining, and global travel.">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;700;900&display=swap');
        body { font-family: 'Inter', sans-serif; background-color: #f8fafc; color: #0f172a; }
        .bg-brand-green { background-color: #15803d; } 
        .text-brand-green { color: #15803d; }
        .bg-brand-orange { background-color: #ea580c; }
        .text-brand-orange { color: #ea580c; }
        .bg-brand-yellow { background-color: #facc15; }
        .review-card { transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); display: flex; flex-direction: column; background: white; border-radius: 1rem; overflow: hidden; }
        .review-card:hover { transform: translateY(-8px); box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1); }
        .star-rating { color: #facc15; }
        .filter-btn.active { background-color: #ea580c; color: white; border-color: #ea580c; }
        .category-badge { font-size: 0.65rem; font-weight: 800; padding: 0.25rem 0.5rem; border-radius: 0.375rem; text-transform: uppercase; letter-spacing: 0.025em; }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    </style>
</head>
<body class="antialiased min-h-screen pt-20">

    <nav class="fixed top-0 w-full bg-white/90 backdrop-blur-md shadow-sm z-50 border-b border-slate-100">
        <div class="max-w-7xl mx-auto px-6 h-16 flex justify-between items-center">
            <a href="index.html" class="flex items-center gap-2 group">
                <span class="bg-brand-green text-white w-8 h-8 flex items-center justify-center rounded-full font-black text-sm group-hover:bg-brand-orange transition-colors">M</span>
                <span class="font-black text-xl tracking-tighter text-slate-900 group-hover:text-brand-orange transition-colors">MsJAG<span class="text-brand-green">.</span></span>
            </a>
            <div class="flex items-center gap-6">
                <a href="index.html" class="text-slate-600 font-bold text-sm hover:text-brand-green transition-colors">Home</a>
                <a href="#contact" class="hidden md:block bg-brand-orange text-white px-4 py-2 rounded-lg text-xs font-black uppercase tracking-widest shadow-md hover:bg-orange-700 transition-colors">Invite MsJAG</a>
            </div>
        </div>
    </nav>

    <header class="bg-slate-900 text-white py-16 px-6 relative overflow-hidden">
        <div class="absolute top-0 right-0 -mt-20 -mr-20 w-96 h-96 bg-brand-green opacity-10 rounded-full blur-3xl"></div>
        <div class="max-w-7xl mx-auto relative z-10">
            <span class="text-brand-orange font-black text-xs uppercase tracking-widest mb-4 block">Independent Media Archive</span>
            <h1 class="text-4xl md:text-6xl font-black mb-4 tracking-tight">The Verdict <span class="text-brand-green">Vault.</span></h1>
            <p class="text-lg md:text-xl text-slate-300 max-w-2xl font-medium mb-8">
                400+ entries covering the best and worst of Toronto and the world. From warehouse parties to five star resorts, if it sucks, it's here.
            </p>
            
            <div class="flex flex-col md:flex-row gap-4">
                <div class="relative flex-grow max-w-2xl">
                    <i class="fas fa-search absolute left-4 top-1/2 -translate-y-1/2 text-slate-400"></i>
                    <input type="text" id="searchInput" placeholder="Search by name, neighborhood, or cuisine..." class="w-full pl-12 pr-6 py-4 rounded-xl bg-slate-800 border-2 border-slate-700 text-white placeholder-slate-500 outline-none focus:border-brand-green transition-all font-bold">
                </div>
                <div class="flex gap-2 overflow-x-auto pb-2 md:pb-0 no-scrollbar">
                    <button class="filter-btn active px-4 py-2 rounded-lg border-2 border-slate-700 text-xs font-black uppercase whitespace-nowrap transition-colors" onclick="setFilter('all', this)">All</button>
                    <button class="filter-btn px-4 py-2 rounded-lg border-2 border-slate-700 text-xs font-black uppercase whitespace-nowrap transition-colors" onclick="setFilter('Dining', this)">Dining</button>
                    <button class="filter-btn px-4 py-2 rounded-lg border-2 border-slate-700 text-xs font-black uppercase whitespace-nowrap transition-colors" onclick="setFilter('Nightlife', this)">Nightlife</button>
                    <button class="filter-btn px-4 py-2 rounded-lg border-2 border-slate-700 text-xs font-black uppercase whitespace-nowrap transition-colors" onclick="setFilter('Travel', this)">Travel</button>
                    <button class="filter-btn px-4 py-2 rounded-lg border-2 border-slate-700 text-xs font-black uppercase whitespace-nowrap transition-colors" onclick="setFilter('Service', this)">Services</button>
                </div>
            </div>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-6 py-12 min-h-[400px]">
        <div id="reviewsGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            <!-- Reviews will be injected here -->
        </div>
    </main>

    <!-- Contact Section: Exactly matched to homepage -->
    <section id="contact" class="max-w-4xl mx-auto px-6 py-20 scroll-mt-24">
        <div class="bg-brand-green rounded-3xl p-10 shadow-2xl relative overflow-hidden text-white text-center">
            <div class="relative z-10">
                <h2 class="text-4xl font-black mb-4 uppercase">INVITE OR SUGGEST?</h2>
                <p class="mb-8 text-yellow-100 text-lg max-w-xl mx-auto">
                    Found a hidden gem? Challenge me to try your spot. Send the details. If it's good, I'll say so. If it's not... well, you know the drill.
                </p>
                
                <div id="form-container" class="max-w-lg mx-auto">
                    <form action="https://api.web3forms.com/submit" method="POST" class="space-y-4">
                        <input type="hidden" name="access_key" value="472a54d7-ca1f-4529-9065-b1978b93cf40">
                        <input type="hidden" name="subject" value="New Tip for MsJAG (Archive Page)">
                        <input type="checkbox" name="botcheck" class="hidden" style="display: none;">
                        
                        <input type="text" name="name" placeholder="Who are you?" required class="w-full px-6 py-4 rounded-lg bg-white bg-opacity-10 border-2 border-green-400 text-white placeholder-green-200 focus:bg-white focus:text-green-900 focus:border-white outline-none transition font-bold">

                        <input type="text" name="place_name" placeholder="Name of Restaurant, Venue, Place, or Store" required class="w-full px-6 py-4 rounded-lg bg-white bg-opacity-10 border-2 border-green-400 text-white placeholder-green-200 focus:bg-white focus:text-green-900 focus:border-white outline-none transition font-bold">
                        
                        <input type="text" name="location" placeholder="City, Province, Country" required class="w-full px-6 py-4 rounded-lg bg-white bg-opacity-10 border-2 border-green-400 text-white placeholder-green-200 focus:bg-white focus:text-green-900 focus:border-white outline-none transition font-bold">
                        
                        <input type="email" name="email" placeholder="Your Email" required class="w-full px-6 py-4 rounded-lg bg-white bg-opacity-10 border-2 border-green-400 text-white placeholder-green-200 focus:bg-white focus:text-green-900 focus:border-white outline-none transition font-bold">
                        
                        <textarea name="reason" rows="3" placeholder="Why should I go? (Max 100 words)" required class="w-full px-6 py-4 rounded-lg bg-white bg-opacity-10 border-2 border-green-400 text-white placeholder-green-200 focus:bg-white focus:text-green-900 focus:border-white outline-none transition font-bold resize-none"></textarea>
                        
                        <button type="submit" class="w-full bg-brand-yellow hover:bg-yellow-300 text-green-900 font-black py-4 px-8 rounded-lg shadow-lg transform transition hover:scale-105">
                            SEND IT
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <footer class="bg-slate-900 text-slate-500 py-12 px-6 text-center text-xs">
        <div class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center gap-6">
            <p class="font-bold">&copy; 2026 MsJAG Reviews. Unfiltered. Independent. Local.</p>
            <div class="flex gap-6 text-lg">
                <a href="https://instagram.com/chowhoundgta" target="_blank" class="hover:text-white transition-colors"><i class="fab fa-instagram"></i></a>
                <a href="https://maps.app.goo.gl/5MNmkR8XkWLsJQz57?g_st=ic" target="_blank" class="hover:text-white transition-colors"><i class="fab fa-google"></i></a>
            </div>
        </div>
    </footer>

    <script>
        const reviews = [
            { category: "Dining", name: "BodyStats Toronto", address: "Western Battery Rd, Toronto", rating: 5, date: "Apr 06, 2026", comment: "BodyStats made getting a DEXA scan easy, quick, and stress-free. Paul, the owner, is professional and the appointment was 15 minutes. Results are immediate." },
            { category: "Dining", name: "Queens Harbour", address: "Queens Quay, Toronto", rating: 5, date: "Aug 16, 2025", comment: "The Caesar salad dressing was a 10 out of 10. Miso and black cod were perfectly executed. House Negroni is excellent." },
            { category: "Nightlife", name: "Geary Ave Warehouse", address: "Geary Ave, Toronto", rating: 5, date: "Oct 10, 2025", comment: "The atmosphere was EDM electric. Laser setup and deep bass sound system created a perfect underground vibe for ART OF US." },
            { category: "Travel", name: "Secrets Royal Beach", address: "Punta Cana, DR", rating: 3, date: "Aug 15, 2025", comment: "The room wasn't spotless and pickup was disorganized. Pools and coffee are great, but maintenance gaps are obvious." },
            { category: "Dining", name: "Burger Drops", address: "Liberty Village, Toronto", rating: 1, date: "Sep 12, 2025", comment: "Found mystery bone shards in the burger twice. Wet, greasy, and felt unsafe. Avoid if you value your teeth." },
            { category: "Service", name: "Speedy Glass", address: "Etobicoke, ON", rating: 1, date: "Oct 20, 2025", comment: "I stood ignored at the desk for minutes. The aggressive response when I finally spoke was unprofessional." },
            { category: "Service", name: "BMW Etobicoke", address: "Etobicoke, ON", rating: 5, date: "Nov 21, 2025", comment: "Lounge pods with individual TVs make the wait civilized. Best car maintenance experience I've had locally." },
            { category: "Nightlife", name: "The Drake Hotel", address: "Queen St W, Toronto", rating: 4, date: "Mar 15, 2026", comment: "Consistent atmosphere and great cocktails. The rooftop remains one of the most reliable spots for a Toronto evening." }
            // All 400 records would be mapped here from the Reviews.json extraction.
        ];

        let currentFilter = 'all';
        const grid = document.getElementById('reviewsGrid');
        const searchInput = document.getElementById('searchInput');

        function getCategoryStyles(cat) {
            switch(cat) {
                case 'Dining': return 'bg-red-100 text-red-800';
                case 'Nightlife': return 'bg-purple-100 text-purple-800';
                case 'Travel': return 'bg-blue-100 text-blue-800';
                default: return 'bg-slate-100 text-slate-800';
            }
        }

        function setFilter(category, btn) {
            currentFilter = category;
            document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            renderReviews(searchInput.value);
        }

        function renderReviews(searchTerm = "") {
            grid.innerHTML = "";
            const filtered = reviews.filter(r => {
                const matchesSearch = r.name.toLowerCase().includes(searchTerm.toLowerCase()) || 
                                     r.comment.toLowerCase().includes(searchTerm.toLowerCase()) ||
                                     r.address.toLowerCase().includes(searchTerm.toLowerCase());
                const matchesFilter = currentFilter === 'all' || r.category === currentFilter;
                return matchesSearch && matchesFilter;
            });

            if (filtered.length === 0) {
                grid.innerHTML = `<div class="col-span-full py-20 text-center"><p class="text-slate-400 font-bold">No verdicts found for your search.</p></div>`;
                return;
            }

            filtered.forEach(r => {
                const stars = '<i class="fas fa-star"></i>'.repeat(r.rating);
                const emptyStars = '<i class="far fa-star"></i>'.repeat(5 - r.rating);
                const catStyle = getCategoryStyles(r.category);
                
                const card = `
                    <article class="review-card p-6 border border-slate-100 shadow-sm">
                        <div class="flex justify-between items-start mb-4">
                            <div>
                                <h3 class="font-black text-xl text-slate-900 leading-tight">${r.name}</h3>
                                <p class="text-xs text-slate-400 font-bold mt-1 uppercase tracking-tight">${r.address}</p>
                            </div>
                            <span class="category-badge ${catStyle}">${r.category}</span>
                        </div>
                        <div class="star-rating mb-4 text-sm">
                            ${stars}${emptyStars}
                        </div>
                        <p class="text-slate-600 leading-relaxed font-medium text-sm flex-grow">
                            "${r.comment}"
                        </p>
                        <div class="mt-6 pt-4 border-t border-slate-50 flex justify-between items-center text-[10px] font-black uppercase tracking-widest text-slate-400">
                            <span>${r.date}</span>
                            <span class="text-brand-orange">Verified Verdict</span>
                        </div>
                    </article>
                `;
                grid.innerHTML += card;
            });
        }

        searchInput.addEventListener('input', (e) => renderReviews(e.target.value));
        renderReviews();
    </script>
</body>
</html>
